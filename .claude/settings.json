{
  "env": {
  "ANTHROPIC_AUTH_TOKEN": "09e49bd3f1074cb5a7628d8d33cd082d.9fsRsne3nkXsUZunsYyG24cg",    
  "ANTHROPIC_BASE_URL": "https://ollama.com",
  "ANTHROPIC_DEFAULT_HAIKU_MODEL": "glm-5.1:cloud",    
  "ANTHROPIC_DEFAULT_OPUS_MODEL": "kimi-k2.6:cloud",
  "ANTHROPIC_DEFAULT_SONNET_MODEL": "minimax-m2.7:cloud",
  "ANTHROPIC_MODEL": "kimi-k2.5:cloud"
  },
  "permissions": {
    "allow": [
      "mcp__stitch",
      "mcp__pencil",
      "Bash(gh repo:*)",
      "Bash(curl -s https://raw.githubusercontent.com/obra/superpowers/main/README.md)",
      "Bash(curl -s https://api.github.com/repos/obra/superpowers/contents/)",
      "Bash(python3 -c \"import sys,json; [print\\(f['name']\\) for f in json.load\\(sys.stdin\\) if isinstance\\(f, dict\\)]\")",
      "Bash(curl -s https://raw.githubusercontent.com/obra/superpowers/main/docs/README.claude.md)",
      "Bash(curl -s https://raw.githubusercontent.com/obra/superpowers/main/CLAUDE.md)",
      "Bash(curl -s https://raw.githubusercontent.com/obra/superpowers/main/.claude-plugin/MANIFEST.md)",
      "Bash(curl -s https://api.github.com/repos/obra/superpowers/contents/.claude-plugin)",
      "Bash(python3 -c \"import sys,json; d=json.load\\(sys.stdin\\); [print\\(f['name']\\) for f in \\(d if isinstance\\(d,list\\) else []\\)]\")",
      "Bash(curl -s https://raw.githubusercontent.com/obra/superpowers/main/.claude-plugin/plugin.json)",
      "Bash(curl -s https://raw.githubusercontent.com/obra/superpowers/main/docs/README.claude-code.md)",
      "Bash(curl -s https://api.github.com/repos/obra/superpowers/contents/commands)",
      "Bash(curl -s https://api.github.com/repos/obra/superpowers/contents/skills)",
      "Read(//home/user/.claude/**)",
      "Bash(claude plugin:*)",
      "Bash(cat)",
      "Read(//tmp/**)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/home/user/.claude/hooks/gitnexus/gitnexus-hook.cjs\"",
            "timeout": 10,
            "statusMessage": "Enriching with GitNexus graph context..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/home/user/.claude/hooks/gitnexus/gitnexus-hook.cjs\"",
            "timeout": 10,
            "statusMessage": "Checking GitNexus index freshness..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  },
  "effortLevel": "medium",
  "model": "opus[1m]"
}

